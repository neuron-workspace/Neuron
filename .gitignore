# Dependencies and generated application output
node_modules/
dist/
release/
coverage/
out/

# Local environment and credentials
.env
.env.*
!.env.example
*.pem
*.p12
*.pfx

# Logs, caches, and OS/editor state
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.cache/
.npm-cache/
.vite/
.DS_Store
Thumbs.db
.idea/
.vscode/

# Agent, model, and local automation state
.agents/
.codex/
.impeccable/

# .claude/ holds the durable dual-agent context system and IS tracked: a
# gitignored context system cannot be read from a fresh clone, and is absent
# from the git worktrees delegated agents run in -- which defeats its purpose.
# Only machine-local Claude state is ignored.
.claude/*
!.claude/*.md
!.claude/context-packs/
.claude/settings.local.json
.claude/shell-snapshots/
.claude/todos/
skills-lock.json
tools/agent-*
tools/qa-*
tools/tmp-*

# Local QA captures and scratch content
*-preview.png
*-screenshot.png
notes/

# Playwright E2E output
test-results/
playwright-report/
