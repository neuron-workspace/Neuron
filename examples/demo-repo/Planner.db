{
  "version": 2,
  "tables": {
    "tasks": {
      "name": "Tasks",
      "schema": {
        "order": [
          "title",
          "status",
          "priority",
          "due",
          "project",
          "blocker",
          "done"
        ],
        "properties": {
          "title": {
            "name": "Task",
            "type": "text"
          },
          "status": {
            "name": "Status",
