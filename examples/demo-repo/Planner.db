{
  "version": 2,
  "tables": {
    "tasks": {
      "name": "Tasks",
      "schema": {
        "order": [
          "title",
          "status",
          "priority",
          "due",
          "project",
          "done"
        ],
        "properties": {
          "title": {
            "name": "Task",
            "type": "text"
          },
          "status": {
            "name": "Status",
            "type": "select",
            "options": [
              {
                "id": "todo",
                "name": "Todo",
                "color": "#8b8b8b"
              },
              {
                "id": "doing",
                "name": "In progress",
                "color": "#528fd1"
              },
              {
                "id": "blocked",
                "name": "Blocked",
                "color": "#c0705f"
              },
              {
                "id": "done",
                "name": "Done",
                "color": "#5aa06c"
              }
            ]
          },
          "priority": {
            "name": "Priority",
            "type": "select",
            "options": [
              {
                "id": "low",
                "name": "Low",
                "color": "#8b8b8b"
              },
              {
                "id": "medium",
                "name": "Medium",
                "color": "#528fd1"
              },
              {
                "id": "high",
                "name": "High",
                "color": "#c0705f"
              }
            ]
          },
          "due": {
            "name": "Due",
            "type": "date"
          },
          "project": {
            "name": "Project",
            "type": "text"
          },
          "done": {
            "name": "Done",
            "type": "checkbox"
          }
        }
      },
